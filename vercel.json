{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "portsync-api": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    },
    "portsync-web": {
      "root": "frontend/",
      "framework": "vite",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "portsync-api" } },
    { "source": "/ws/(.*)", "destination": { "service": "portsync-api" } },
    { "source": "/(.*)", "destination": { "service": "portsync-web" } }
  ]
}
