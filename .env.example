# ---------------------------------------------------------------------------
# PortSync — Docker Compose / deployment environment template
# Copy to .env and replace every placeholder. Never commit the real .env.
# ---------------------------------------------------------------------------

# PostgreSQL service credentials (used by docker-compose.yml).
POSTGRES_USER=portsync
POSTGRES_DB=portsync
# Required. Set a strong password; compose refuses to start without it.
POSTGRES_PASSWORD=change-me

# Backend database URL. Leave unset for the bundled PostgreSQL service;
# uncomment and edit to point at Supabase, RDS, etc.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/portsync

# Comma-separated browser origins allowed to call the API.
# Compose serves the frontend on :8080; local Vite dev runs on :5173.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Authentication & sessions. HttpOnly cookie + CSRF double-submit; tokens are
# stored hashed. Demo accounts are seeded with DEMO_PASSWORD on first start;
# public signup always creates read-only viewers. Set SEED_DEMO_USERS=false
# and change DEMO_PASSWORD before exposing this deployment.
SESSION_COOKIE_NAME=portsync_session
SESSION_HOURS=12
REMEMBER_DAYS=30
CSRF_HEADER=X-CSRF-Token
SEED_DEMO_USERS=true
DEMO_PASSWORD=PortSync2026!

# Live simulator clock.
SIM_ENABLED=true
SIM_TICK_SECONDS=4
SIM_SEED=20261

# Optional OpenAI-compatible LLM. Leave LLM_API_KEY empty to use the
# grounded rules engine. Read by the backend only; never expose this to the
# frontend or commit a real key.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
