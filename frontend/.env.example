# Leave both blank for local development: Vite proxies /api and /ws to
# http://127.0.0.1:8010 (see vite.config.ts).
#
# For a split deployment (static frontend + hosted API), set the backend
# origin. Use https:// for the API and wss:// for the socket.
# VITE_API_URL=https://portsync-api.example.com
# VITE_WS_URL=wss://portsync-api.example.com/ws/operations
VITE_API_URL=
VITE_WS_URL=
