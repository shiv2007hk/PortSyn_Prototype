# ---- Runtime --------------------------------------------------------------
ENVIRONMENT=development
# PostgreSQL (primary deployment target), e.g.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/portsync
# SQLite fallback is used when DATABASE_URL is unset (local development).
# DATABASE_URL=

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Synthetic simulator --------------------------------------------------
SIM_ENABLED=true
SIM_TICK_SECONDS=4
SIM_SEED=20261

# ---- Authentication & sessions --------------------------------------------
# Session auth uses an HttpOnly cookie plus CSRF double-submit. Tokens are
# stored hashed; no plaintext credentials are ever persisted or logged.
SESSION_COOKIE_NAME=portsync_session
SESSION_HOURS=12
REMEMBER_DAYS=30
CSRF_HEADER=X-CSRF-Token

# Demo accounts created on first start:
#   priya.menon@portsync.demo  (supervisor)
#   arjun.rao@portsync.demo    (operator)
# Public signup always creates read-only "viewer" accounts.
# Set SEED_DEMO_USERS=false and change DEMO_PASSWORD for anything exposed
# beyond localhost. The cookie is flagged Secure automatically when
# ENVIRONMENT=production or the request arrives over HTTPS.
SEED_DEMO_USERS=true
DEMO_PASSWORD=PortSync2026!

# ---- Optional LLM assistant (OpenAI-compatible) ---------------------------
# Leave LLM_API_KEY empty to run the grounded rules engine. Keys are read on
# the backend only and are never exposed to the frontend.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
